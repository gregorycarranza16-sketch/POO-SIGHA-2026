class PeriodoAcademico:
    def __init__(self, codigoPeriodo: str, fechaInicio: str, fechaFin: str, estado: str = "Inactivo"):
        # Atributos privados (-)
        self.__codigoPeriodo = codigoPeriodo
        self.__fechaInicio = fechaInicio
        self.__fechaFin = fechaFin
        self.__estado = estado
        # Relación de composición (1..* Horarios)
        self.__horarios = []

    def agregarHorario(self, horario) -> None:
        if horario:
            self.__horarios.append(horario)

    def activarPeriodo(self) -> None:
        self.__estado = "Activo"
        print(f"[INFO] Periodo académico {self.__codigoPeriodo} ACTIVADO ({self.__fechaInicio} a {self.__fechaFin}).")

    def finalizarPeriodo(self) -> None:
        self.__estado = "Finalizado"
        print(f"[INFO] Periodo académico {self.__codigoPeriodo} FINALIZADO.")
