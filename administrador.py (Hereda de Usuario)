from usuario import Usuario
from horario import Horario

class Administrador(Usuario):
    def __init__(self, identificacion: str, nombres: str, apellidos: str, correo: str, clave: str, cargo: str):
        super().__init__(identificacion, nombres, apellidos, correo, clave)
        # Atributo privado (-)
        self.__cargo = cargo
        self.__horarios_gestionados = []  # Relación gestiona (0..*)

    def crearHorario(self, asignatura, aula, idHorario="H-001", diaSemana="Lunes", 
                     horaInicio="07:00", horaFin="09:00", docente=None) -> Horario:
        if aula.verificarDisponibilidad(diaSemana, horaInicio, horaFin):
            nuevo_horario = Horario(idHorario, diaSemana, horaInicio, horaFin, "Activo", asignatura, aula, docente)
            aula.agregarHorario(nuevo_horario)
            if docente:
                docente.asignarHorario(nuevo_horario)
            self.__horarios_gestionados.append(nuevo_horario)
            print(f"[OK] Horario {idHorario} creado exitosamente por {self.nombre_completo}.")
            return nuevo_horario
        else:
            print(f"[ALERTA] El aula {aula.codigoAula} no está disponible el {diaSemana} de {horaInicio} a {horaFin}.")
            return None

    def modificarHorario(self, idHorario: str, nuevoDia: str = None, nuevaHoraInicio: str = None, 
                         nuevaHoraFin: str = None, nuevoEstado: str = "Modificado") -> bool:
        for h in self.__horarios_gestionados:
            if h.idHorario == idHorario:
                dia = nuevoDia if nuevoDia else h.diaSemana
                inicio = nuevaHoraInicio if nuevaHoraInicio else h.horaInicio
                fin = nuevaHoraFin if nuevaHoraFin else h.horaFin
                h.actualizarDatos(dia, inicio, fin, nuevoEstado)
                print(f"[OK] Horario {idHorario} modificado correctamente.")
                return True
        print(f"[ERROR] No se encontró el horario con ID {idHorario}.")
        return False
