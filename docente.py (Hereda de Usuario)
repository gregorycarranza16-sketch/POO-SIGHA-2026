from usuario import Usuario

class Docente(Usuario):
    def __init__(self, identificacion: str, nombres: str, apellidos: str, correo: str, clave: str, 
                 especialidad: str, maxHorasSemanales: int):
        super().__init__(identificacion, nombres, apellidos, correo, clave)
        # Atributos privados (-)
        self.__especialidad = especialidad
        self.__maxHorasSemanales = maxHorasSemanales
        # Relaciones: imparte Asignaturas (0..*) y tiene Horarios (0..*)
        self.__asignaturas = []
        self.__horarios = []

    def asignarHorario(self, horario) -> None:
        self.__horarios.append(horario)

    def agregarAsignatura(self, asignatura) -> None:
        self.__asignaturas.append(asignatura)

    def consultarHorario(self) -> None:
        print(f"\n--- Horario del Docente: {self.nombre_completo} ({self.__especialidad}) ---")
        if not self.__horarios:
            print("No tiene horarios asignados.")
        for h in self.__horarios:
            print(h.mostrarDetalle())
